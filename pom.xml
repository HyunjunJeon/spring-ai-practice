<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring AI 2.0.x 는 Spring Boot 4.0.x / 4.1.x 위에서 동작한다. 4.1.x 를 쓰는 이유는 README 참고. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example.miniagent</groupId>
    <artifactId>agent-forge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>agent-forge</name>
    <description>pi-agent 스타일의 최소 에이전트 원형 + 플러그인 (Spring AI 2.0.1 학습용)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Surefire 의 늦은 @{argLine} 치환을 초기화하고 다른 계측 도구의 옵션을 보존한다. -->
        <argLine/>
        <!--
          버전을 반드시 명시 고정한다.
          Maven Central 메타데이터는 마일스톤 2.1.0-M1 을 <release> 로 표시하므로
          versions:use-latest-releases, Renovate 등이 마일스톤을 끌어올 수 있다.
        -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- 아키텍처 규칙 테스트 전용. 1.5.1 은 Maven Central 업로드 기준 2026-09-25. -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <modules>
        <module>agent-core</module>
        <module>plugins/plugin-fake-model</module>
        <module>plugins/plugin-codex-model</module>
        <module>plugins/plugin-claude-model</module>
        <module>plugins/plugin-fs</module>
        <module>plugins/plugin-bash</module>
        <module>plugins/plugin-permission</module>
        <module>plugins/plugin-memory</module>
        <module>plugins/plugin-trace</module>
        <module>plugins/plugin-skills</module>
        <module>plugins/plugin-mcp</module>
        <module>plugins/plugin-tui</module>
        <module>agent-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 의 모든 모듈 버전은 BOM 하나로 맞춘다. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 내부 모듈 -->
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-fake-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-codex-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-claude-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-fs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-bash</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-permission</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-trace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-skills</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.miniagent</groupId>
                <artifactId>plugin-tui</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--
              아키텍처 규칙 테스트. archunit-junit6 엔진은 JUnit Platform 6.1 을 요구하지만
              Spring Boot 4.1.1 은 6.0.3 을 관리하므로, 엔진 없는 코어 라이브러리를 Jupiter @Test 에서 호출한다.
            -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- @Tool 메서드의 파라미터 이름을 JSON 스키마에 쓰려면 -parameters 가 필요하다. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
