<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.miniagent</groupId>
        <artifactId>mini-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-app</artifactId>
    <name>agent-app</name>
    <description>터미널 REPL. 어떤 플러그인을 붙일지는 이 pom 의 의존성이 결정한다.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 원형 -->
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>

        <!--
          플러그인: 의존성을 지우면 플러그인이 빠진다(컴파일 타임).
          남겨 두고 agent.plugins.<id>.enabled=false 로 끄면 런타임에 빠진다.
        -->
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-fs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-bash</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-permission</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-skills</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-mcp</artifactId>
        </dependency>
        <!-- 화면 플러그인: 대화형일 때 REPL 대신 전체 화면 TUI (agent.ui=tui) -->
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-tui</artifactId>
        </dependency>

        <!--
          모델 provider: 셋 다 classpath 에 두고 spring.ai.model.chat 값(=Spring profile)으로 하나만 켠다.
          각 starter 의 자동 구성은 @ConditionalOnProperty(spring.ai.model.chat = 자기이름) 이다.
        -->
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-fake-model</artifactId>
        </dependency>
        <!-- ChatGPT 구독(Codex OAuth). spring.ai.model.chat=codex -->
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-codex-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.miniagent</groupId>
            <artifactId>plugin-claude-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- 기본은 꺼 둔다. spring.ai.chat.client.tool-search-advisor.enabled=true 일 때만 도구 루프를 교체한다. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-tool-search-advisor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>mini-agent</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Java 21 에서 Mockito 의 동적 self-attach 대신 시작 시 계측한다. -->
                    <argLine>@{argLine} -javaagent:"${org.mockito:mockito-core:jar}"</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
