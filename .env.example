# cp .env.example .env 후 필요한 키만 채운다. .env 는 git 에 올라가지 않는다.
# agent.sh 가 이 파일을 Spring 속성으로 읽는다 (spring.config.import).
# codex 프로필은 키가 필요 없다 (ChatGPT 로그인). 모델만 바꿀 수 있다.
# CODEX_MODEL=gpt-6-luna
# CODEX_REASONING_EFFORT=xhigh
# claude 프로필: 앱의 /login 으로 Claude Pro/Max 로그인. Java 가 OAuth 를 직접 처리한다.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_CLI_VERSION=2.1.289
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
ZAI_API_KEY=
